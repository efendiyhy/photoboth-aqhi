[Unit]
Description=Photobooth AQHI Lab (web server lokal)
After=network.target
Wants=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
# Port bisa diubah di /etc/default/aqhi-photobooth (JANGAN 5000, sudah dipakai layanan lain)
Environment=PORT=8080
Environment=CAMERA_DEVICES=/dev/video0
EnvironmentFile=-/etc/default/aqhi-photobooth
ExecStart=__NODE__ __APP_DIR__/server.js
Restart=always
RestartSec=3
SupplementaryGroups=video
# Izinkan bind port < 1024 (mis. PORT=80) tanpa root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
